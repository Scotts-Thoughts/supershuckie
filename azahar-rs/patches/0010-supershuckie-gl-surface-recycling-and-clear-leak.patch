     /// Gets an opaque tick-value used to indicate to the garbage collector what surfaces can be
     /// safely deleted.
     u64 GetResourceFreeTick() {
-        return GetResourceTick();
+        // Super Shuckie: OpenGL orders a texture's reuse after the commands still using it, so a
+        // discarded surface can be recycled at once. With the current tick here nothing ever was:
+        // the collector destroyed every discarded surface at the next frame, before a later
+        // frame could ask for it again, so render-to-texture effects re-created their textures
+        // and framebuffers every frame (each a stall in threaded GL drivers).
+        return GetResourceTick() + 1;
+    }
+
+    /// Super Shuckie: frames a discarded surface is kept for recycling before it is destroyed.
