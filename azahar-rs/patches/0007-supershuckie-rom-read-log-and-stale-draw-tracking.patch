 namespace FileSys {
 
+namespace {
+
+// Super Shuckie: see SetRomReadLog.
+struct RomReadLog {
+    std::mutex mutex;
+    std::atomic<bool> enabled{false};
+    std::string path;
+    std::vector<std::pair<u64, u64>> reads;
+};
+
+RomReadLog& GetRomReadLog() {
+    static RomReadLog log;
+    return log;
+}
+
+// More than a keyframe interval of reads is never needed; past this the oldest half goes.
+constexpr std::size_t MAX_LOGGED_ROM_READS = 1 << 16;
+
+// Where byte `offset` of `file` is in the file on disk underneath it, when it is reached through
+// plain sub-file windows only (no decryption or decompression on the way).
+std::optional<u64> OffsetInBaseFile(const FileUtil::IOFileBase* file, u64 offset) {
+    while (file) {
+        if (const auto* window = dynamic_cast<const FileUtil::SubIOFile*>(file)) {
+            offset += window->SubFileOffset();
+            file = window->ChildFile();
+            continue;
+        }
+        if (dynamic_cast<const FileUtil::IOFile*>(file)) {
+            return offset;
+        }
+        return std::nullopt;
+    }
+    return std::nullopt;
+}
+
+void NoteRomRead(const FileUtil::IOFileBase& file, std::size_t offset, std::size_t length) {
+    auto& log = GetRomReadLog();
+    if (!log.enabled.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const auto at = OffsetInBaseFile(&file, offset);
+    if (!at) {
+        return;
+    }
+    std::lock_guard lock{log.mutex};
+    if (!log.enabled.load(std::memory_order_relaxed) || file.Filename() != log.path) {
+        return;
+    }
+    auto& reads = log.reads;
+    if (!reads.empty() && reads.back().first + reads.back().second == *at) {
+        reads.back().second += length;
+        return;
+    }
+    if (reads.size() >= MAX_LOGGED_ROM_READS) {
+        reads.erase(reads.begin(), reads.begin() + reads.size() / 2);
+    }
+    reads.emplace_back(*at, length);
+}
+
+} // namespace
+
+void SetRomReadLog(const std::string& game_path, bool enabled) {
+    auto& log = GetRomReadLog();
+    std::lock_guard lock{log.mutex};
+    log.path = game_path;
+    log.reads.clear();
+    log.enabled.store(enabled, std::memory_order_relaxed);
+}
+
+std::vector<std::pair<u64, u64>> TakeRomReads() {
+    auto& log = GetRomReadLog();
+    std::lock_guard lock{log.mutex};
+    return std::exchange(log.reads, {});
+}
