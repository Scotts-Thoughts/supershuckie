+// Super Shuckie: the colour buffer a draw goes to, as [start, end) (see VideoCore::g_stale_surfaces).
+std::pair<PAddr, PAddr> ColorBufferRange(const Pica::RegsInternal& regs) {
+    const auto& fb = regs.framebuffer.framebuffer;
+    const PAddr start = fb.GetColorBufferPhysicalAddress();
+    u32 bytes_per_pixel = 4;
+    switch (fb.color_format.Value()) {
+    case Pica::FramebufferRegs::ColorFormat::RGB8:
+        bytes_per_pixel = 3;
+        break;
+    case Pica::FramebufferRegs::ColorFormat::RGB5A1:
+    case Pica::FramebufferRegs::ColorFormat::RGB565:
+    case Pica::FramebufferRegs::ColorFormat::RGBA4:
+        bytes_per_pixel = 2;
+        break;
+    default:
+        break;
+    }
+    return {start, start + fb.GetWidth() * fb.GetHeight() * bytes_per_pixel};
+}
