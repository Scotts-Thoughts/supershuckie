 /// program's memory is unaffected; only the picture is stale until it is cleared.
 inline std::atomic<bool> g_skip_drawing{false};
 
+/// Super Shuckie: colour buffers whose picture is stale because draws into them were skipped
+/// (see g_skip_drawing), with the frame (g_draw_frame) the first of those was skipped in. A
+/// seek that skipped drawing and still has one at its end redoes that stretch drawn. Touched on
+/// the emulation thread only.
+struct StaleSurface {
+    PAddr start;
+    PAddr end;
+    u64 since;
+};
+inline std::vector<StaleSurface> g_stale_surfaces;
+/// The frontend's frame counter, set before each frame it runs.
+inline std::atomic<u64> g_draw_frame{0};
+
+inline StaleSurface* FindStaleSurface(PAddr addr) {
+    for (auto& surface : g_stale_surfaces) {
+        if (addr >= surface.start && addr < surface.end) {
+            return &surface;
+        }
+    }
+    return nullptr;
+}
+
+inline void MarkStale(PAddr start, PAddr end, u64 since) {
+    for (auto& surface : g_stale_surfaces) {
+        if (surface.start == start) {
+            surface.end = std::max(surface.end, end);
+            surface.since = std::min(surface.since, since);
+            return;
+        }
+    }
+    g_stale_surfaces.push_back({start, end, since});
+}
+
+/// A draw into the colour buffer [start, end) was skipped.
+inline void NoteSkippedDraw(PAddr start, PAddr end) {
+    if (start != 0 && end > start) {
+        MarkStale(start, end, g_draw_frame.load(std::memory_order_relaxed));
+    }
+}
+
+/// A draw into the colour buffer [start, end) was made, sampling textures at `textures`: when
+/// one of them is stale, the draw's output is too. A drawn draw does not make its target fresh
+/// (it may redraw only part of it); only a fill does. Taking a buffer drawn again as whole was
+/// tried and saved few redos (13 of 60 seeks still redone on Pokémon Alpha Sapphire).
+inline void NoteDrawnDraw(PAddr start, PAddr end, const PAddr* textures, std::size_t count) {
+    if (g_stale_surfaces.empty() || start == 0 || end <= start) {
+        return;
+    }
+    u64 since = ~u64{0};
+    for (std::size_t i = 0; i < count; i++) {
+        if (const auto* surface = FindStaleSurface(textures[i])) {
+            since = std::min(since, surface->since);
+        }
+    }
+    if (since != ~u64{0}) {
+        MarkStale(start, end, since);
+    }
+}
+
+/// [start, end) was filled: a buffer it clears is fresh again. A clear starts at the buffer and
+/// covers it; the buffer's own extent is only an estimate (width x height x bytes per pixel of
+/// the draw that marked it), so most of it is enough.
+inline void NoteFill(PAddr start, PAddr end) {
+    std::erase_if(g_stale_surfaces, [&](const StaleSurface& s) {
+        const PAddr covered_end = std::min(end, s.end);
+        return s.start >= start && s.start < end && (covered_end - s.start) * 4 >= (s.end - s.start) * 3;
+    });
+}
+
+/// A display transfer or texture copy from `src` into [dst, dst_end): the destination is as
+/// stale as its source.
+inline void NoteTransfer(PAddr src, PAddr dst, PAddr dst_end) {
+    if (g_stale_surfaces.empty()) {
+        return;
+    }
+    if (const auto* source = FindStaleSurface(src)) {
+        MarkStale(dst, std::max(dst_end, dst + 1), source->since);
+    } else {
+        std::erase_if(g_stale_surfaces, [&](const StaleSurface& s) { return s.start == dst && s.end <= dst_end; });
+    }
+}
