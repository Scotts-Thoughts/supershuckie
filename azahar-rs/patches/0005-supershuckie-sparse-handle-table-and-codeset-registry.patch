+// Super Shuckie: the program binaries loaded in this process, by content hash; a save state
+// stores the key, not the bytes (they never change after loading, and a keyframe every few
+// seconds cannot afford 4 ms and 30 MB for them). A state can therefore only be loaded in a
+// process that has loaded the same game, which is what the replay player guarantees.
+static std::unordered_map<u64, std::shared_ptr<const std::vector<u8>>> g_codeset_memory;
+static std::mutex g_codeset_memory_mutex;
+
+void CodeSet::RegisterMemoryForSaveStates() {
+    memory_key = XXH3_64bits(memory.data(), memory.size()) ^ (memory.size() << 1) ^ program_id;
+    std::scoped_lock lock{g_codeset_memory_mutex};
+    if (!g_codeset_memory.contains(memory_key)) {
+        g_codeset_memory.emplace(memory_key, std::make_shared<const std::vector<u8>>(memory));
