+// Super Shuckie: a block read of the VRAM mapping is a read for VideoCore's access tracking.
+static void NoteVramBlockRead(VAddr src_addr, std::size_t size) {
+    if (src_addr < VRAM_VADDR_END && u64{src_addr} + size > VRAM_VADDR) {
+        const VAddr start = std::max<VAddr>(src_addr, VRAM_VADDR);
+        VideoCore::NoteVramRead(start - VRAM_VADDR + VRAM_PADDR, u64{src_addr} + size - start);
+    }
+}
+
 void MemorySystem::ReadBlock(const Kernel::Process& process, const VAddr src_addr,
                              void* dest_buffer, const std::size_t size) {
+    NoteVramBlockRead(src_addr, size);
     return impl->ReadBlockImpl<false>(process, src_addr, dest_buffer, size);
 }
 
 void MemorySystem::ReadBlock(VAddr src_addr, void* dest_buffer, std::size_t size) {
+    NoteVramBlockRead(src_addr, size);
     const auto& process = *impl->system.Kernel().GetCurrentProcess();
     return impl->ReadBlockImpl<false>(process, src_addr, dest_buffer, size);
 }
