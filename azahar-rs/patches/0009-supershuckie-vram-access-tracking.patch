+// Super Shuckie: the depth/stencil buffer of a draw, as [start, end) (see VideoCore::NoteVramWrite).
+std::pair<PAddr, PAddr> DepthBufferRange(const Pica::RegsInternal& regs) {
+    const auto& fb = regs.framebuffer.framebuffer;
+    const PAddr start = fb.GetDepthBufferPhysicalAddress();
+    u32 bytes_per_pixel = 4;
+    switch (fb.depth_format.Value()) {
+    case Pica::FramebufferRegs::DepthFormat::D16:
+        bytes_per_pixel = 2;
+        break;
+    case Pica::FramebufferRegs::DepthFormat::D24:
+        bytes_per_pixel = 3;
+        break;
+    default:
+        break;
+    }
+    return {start, start + fb.GetWidth() * fb.GetHeight() * bytes_per_pixel};
+}
