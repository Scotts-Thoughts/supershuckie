+/// Super Shuckie: what touched each 4 KB page of VRAM first since the last take, while
+/// g_vram_access_tracking is set: 0 nothing, 1 a read, 2 a write. The replay recorder leaves a
+/// VRAM page out of a keyframe when the GPU rewrites it before anything reads it (render targets,
+/// display framebuffers), which is most of what changes in VRAM between two keyframes. Reads are
+/// texture sampling, transfer and copy sources, vertex and index data, command lists, and HLE
+/// block reads: what carries a page's content into something that outlives the frame. Blending,
+/// depth tests and the screen showing a framebuffer only affect that frame's picture, which a
+/// seek redraws several times before showing it, so they do not count. Writes are draw colour
+/// and depth targets, transfer, copy and fill destinations. A write that covers only part of a
+/// page counts as a read: the rest of the page would stay stale. CPU reads through the JIT's
+/// fast path are not seen (games do not read VRAM that way in practice). Emulation thread only.
+constexpr PAddr VRAM_TRACK_START = 0x18000000;
+constexpr u32 VRAM_TRACK_SIZE = 0x00600000;
+constexpr u32 VRAM_TRACK_PAGE = 4096;
+constexpr std::size_t VRAM_TRACK_PAGES = VRAM_TRACK_SIZE / VRAM_TRACK_PAGE;
+inline std::atomic<bool> g_vram_access_tracking{false};
+inline std::array<u8, VRAM_TRACK_PAGES> g_vram_first_access{};
+
+/// [start, start + size) clipped to VRAM as page-relative byte offsets, or nothing.
+inline bool ClipToVram(PAddr start, u64 size, u32& from, u32& to) {
+    if (size == 0) {
+        return false;
+    }
+    const u64 end = std::min<u64>(u64{start} + size, u64{VRAM_TRACK_START} + VRAM_TRACK_SIZE);
+    const u64 begin = std::max<u64>(start, VRAM_TRACK_START);
+    if (begin >= end) {
+        return false;
+    }
+    from = static_cast<u32>(begin - VRAM_TRACK_START);
+    to = static_cast<u32>(end - VRAM_TRACK_START);
+    return true;
+}
+
+inline void NoteVramRead(PAddr start, u64 size) {
+    if (!g_vram_access_tracking.load(std::memory_order_relaxed)) {
+        return;
+    }
+    u32 from, to;
+    if (!ClipToVram(start, size, from, to)) {
+        return;
+    }
+    for (u32 page = from / VRAM_TRACK_PAGE; page <= (to - 1) / VRAM_TRACK_PAGE; page++) {
+        if (g_vram_first_access[page] == 0) {
+            g_vram_first_access[page] = 1;
+        }
+    }
+}
+
+inline void NoteVramWrite(PAddr start, u64 size) {
+    if (!g_vram_access_tracking.load(std::memory_order_relaxed)) {
+        return;
+    }
+    u32 from, to;
+    if (!ClipToVram(start, size, from, to)) {
+        return;
+    }
+    const u32 first_full = (from + VRAM_TRACK_PAGE - 1) / VRAM_TRACK_PAGE;
+    const u32 end_full = to / VRAM_TRACK_PAGE; // exclusive
+    for (u32 page = from / VRAM_TRACK_PAGE; page <= (to - 1) / VRAM_TRACK_PAGE; page++) {
+        if (g_vram_first_access[page] == 0) {
+            g_vram_first_access[page] = (page >= first_full && page < end_full) ? 2 : 1;
+        }
+    }
+}
