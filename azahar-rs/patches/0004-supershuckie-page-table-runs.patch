+// Super Shuckie: the RAM regions in one block whose written pages the OS tracks, so a raw save
+// state copies only what changed since the buffer's previous state (see MemorySystem::RawRegionIo).
+namespace {
+
+constexpr std::size_t RAM_PAGE = 0x1000;
+
+class RamBlock {
+public:
+    static constexpr std::size_t FCRAM_OFFSET = 0;
+    static constexpr std::size_t VRAM_OFFSET = FCRAM_OFFSET + Memory::FCRAM_N3DS_SIZE;
+    static constexpr std::size_t N3DS_OFFSET = VRAM_OFFSET + Memory::VRAM_SIZE;
+    static constexpr std::size_t DSP_OFFSET = N3DS_OFFSET + Memory::N3DS_EXTRA_RAM_SIZE;
+    static constexpr std::size_t TOTAL = DSP_OFFSET + Memory::DSP_RAM_SIZE;
+    static constexpr std::size_t PAGES = TOTAL / RAM_PAGE;
+
+    RamBlock() {
+#ifdef _WIN32
+        base = static_cast<u8*>(VirtualAlloc(nullptr, TOTAL, MEM_RESERVE | MEM_COMMIT | MEM_WRITE_WATCH,
+                                             PAGE_READWRITE));
+        tracked = base != nullptr;
+        if (!base) {
+            LOG_WARNING(HW_Memory, "write-watched RAM block unavailable; save states copy all of it");
+        }
+#endif
+        if (!base) {
+            fallback = std::make_unique<u8[]>(TOTAL);
+            base = fallback.get();
+        }
+    }
+
+    ~RamBlock() {
+#ifdef _WIN32
+        if (tracked) {
+            VirtualFree(base, 0, MEM_RELEASE);
+        }
+#endif
+    }
+
+    RamBlock(const RamBlock&) = delete;
+    RamBlock& operator=(const RamBlock&) = delete;
+
+    /// Page indexes (within the block) written since the previous call (or since the block was
+    /// made), and start a new interval. False when writes are not tracked here: every page may
+    /// have changed.
+    bool CollectWrittenPages(std::vector<u32>& pages) {
+        pages.clear();
+        if (!tracked) {
+            return false;
+        }
+#ifdef _WIN32
+        if (scratch.size() < PAGES) {
+            scratch.resize(PAGES);
+        }
+        ULONG_PTR count = scratch.size();
+        DWORD granularity = 0;
+        if (GetWriteWatch(WRITE_WATCH_FLAG_RESET, base, TOTAL, scratch.data(), &count, &granularity) != 0) {
+            LOG_WARNING(HW_Memory, "GetWriteWatch failed ({}); this state copies all RAM", GetLastError());
+            return false;
+        }
+        pages.reserve(count);
+        for (ULONG_PTR i = 0; i < count; i++) {
+            pages.push_back(static_cast<u32>((static_cast<u8*>(scratch[i]) - base) / RAM_PAGE));
+        }
+        return true;
+#else
+        return false;
+#endif
+    }
+
+    u8* base = nullptr;
+    bool tracked = false;
+
+private:
+    std::unique_ptr<u8[]> fallback;
+    std::vector<void*> scratch;
+};
+
+/// The block outlives the memory system: every save-state load builds a new MemorySystem, and
+/// reusing the block keeps its pages resident (a fresh 266 MB block costs tens of thousands of
+/// page faults on the first load into it) and keeps the written-page history. A new system that
+/// is not loading a state zeroes it, as fresh memory was zero before.
+std::unique_ptr<RamBlock> g_spare_ram_block;
+
+/// Which pages a state's generation changed, oldest first; see MemorySystem::RawRegionIo.
+struct RamGeneration {
+    u64 id;
+    bool all;              ///< every page may have changed (writes were not tracked)
+    std::vector<u64> bits; ///< one bit per block page otherwise
+};
+std::deque<RamGeneration> g_ram_generations;
+constexpr std::size_t RAM_GENERATIONS_KEPT = 512;
+std::atomic<u64> g_ram_generation_counter{0};
+
+MemorySystem::RawRegionIo* g_raw_region_io = nullptr;
+
+struct CopyChunk {
+    std::size_t src;
+    std::size_t dst;
+    std::size_t len;
+};
+
+/// memcpy the chunks on a few threads: one thread moves 128 MB in 10-12 ms, four in 3-4.
+void CopyChunks(const u8* src_base, u8* dst_base, const std::vector<CopyChunk>& chunks) {
+    std::size_t total = 0;
+    for (const CopyChunk& c : chunks) {
+        total += c.len;
+    }
+    const unsigned workers = total < (8u << 20) ? 1 : std::min(4u, std::max(1u, std::thread::hardware_concurrency()));
+    if (workers == 1) {
+        for (const CopyChunk& c : chunks) {
+            std::memcpy(dst_base + c.dst, src_base + c.src, c.len);
+        }
+        return;
+    }
+    std::atomic<std::size_t> next{0};
+    auto work = [&] {
+        for (;;) {
+            const std::size_t i = next.fetch_add(1);
+            if (i >= chunks.size()) {
+                break;
+            }
+            std::memcpy(dst_base + chunks[i].dst, src_base + chunks[i].src, chunks[i].len);
+        }
+    };
+    std::vector<std::thread> threads;
+    for (unsigned w = 1; w < workers; w++) {
+        threads.emplace_back(work);
+    }
+    work();
+    for (std::thread& t : threads) {
+        t.join();
+    }
+}
