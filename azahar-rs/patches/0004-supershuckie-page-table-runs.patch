+    // The RAM regions (FCRAM, VRAM, New 3DS extra RAM, DSP RAM) live in one host block whose
+    // written pages the OS tracks where it can (Windows write watch). A raw state (savestate.cpp)
+    // holds the regions back to back in front of the boost archive; while a RawRegionIo is set,
+    // the archive part of this system's serialisation copies the regions to/from it instead of
+    // through the archive, and a copy into a buffer that still holds a recent state of this
+    // process copies only the pages written since.
+    struct RawRegionIo {
+        u8* dst = nullptr;         ///< saving: the regions go here (RawRegionsSize() bytes)
+        const u8* src = nullptr;   ///< loading: the regions come from here
+        u64 dst_generation = 0;    ///< saving: the generation `dst` still holds, 0 for unknown
+        u64 generation_out = 0;    ///< saving: the generation `dst` holds afterwards
+        std::size_t pages_copied = 0; ///< saving: how many 4 KB pages were copied
+    };
+    static std::size_t RawRegionsSize();
+    static void SetRawRegionIo(RawRegionIo* io);
