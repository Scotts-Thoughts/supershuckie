+// Applies exactly the unit-state side effects of DrawScanline_BGOBJ without producing pixels:
+// the horizontal window activity bits toggled by CalculateWindowMask, the affine reference
+// registers advanced by every affine-class BG drawer, and the BG mosaic line counter. Keep this
+// in sync with DrawScanline_BGOBJ / DrawScanlineBGMode* / DrawBG_Affine / DrawBG_Extended /
+// DrawBG_Large and Unit::CalculateWindowMask.
+void SoftRenderer::SkipScanline_BGOBJ(u32 line)
+{
+    // forced blank disables BG/OBJ compositing (and none of the side effects happen)
+    if (CurUnit->DispCnt & (1<<7))
+        return;
+
+    u32 dispCnt = CurUnit->DispCnt;
+
+    if (dispCnt & 0xE000)
+    {
+        // CalculateWindowMask scans x = 0..255 doing "if (x == x2) clear; else if (x == x1) set"
+        // on bit 1 of WinNActive; both coordinates are u8, so the last event decides.
+        if (dispCnt & (1<<14))
+        {
+            if (CurUnit->Win1Coords[0] > CurUnit->Win1Coords[1]) CurUnit->Win1Active |=  0x2;
+            else                                                 CurUnit->Win1Active &= ~0x2;
+        }
+        if (dispCnt & (1<<13))
+        {
+            if (CurUnit->Win0Coords[0] > CurUnit->Win0Coords[1]) CurUnit->Win0Active |=  0x2;
+            else                                                 CurUnit->Win0Active &= ~0x2;
+        }
+    }
+
+    // every affine-class BG drawer ends with BGXRefInternal += rotB, BGYRefInternal += rotD
+    u32 bgmode = dispCnt & 0x7;
+    bool bg3Affine = false, bg2Affine = false;
+    if (bgmode <= 5)
+    {
+        bg3Affine = (dispCnt & 0x0800) && bgmode >= 1;                                   // Affine (1,2) / Extended (3..5)
+        bg2Affine = (dispCnt & 0x0400) && (bgmode == 2 || bgmode == 4 || bgmode == 5);   // Affine (2,4) / Extended (5)
+    }
+    else if (bgmode == 6)
+    {
+        bg2Affine = (dispCnt & 0x0400);                                                  // Large
+    }
+    if (bg3Affine)
+    {
+        CurUnit->BGXRefInternal[1] += CurUnit->BGRotB[1];
+        CurUnit->BGYRefInternal[1] += CurUnit->BGRotD[1];
+    }
+    if (bg2Affine)
+    {
+        CurUnit->BGXRefInternal[0] += CurUnit->BGRotB[0];
+        CurUnit->BGYRefInternal[0] += CurUnit->BGRotD[0];
+    }
+
+    if (CurUnit->BGMosaicY >= CurUnit->BGMosaicYMax)
+    {
+        CurUnit->BGMosaicY = 0;
+        CurUnit->BGMosaicYMax = CurUnit->BGMosaicSize[1];
+    }
+    else
+        CurUnit->BGMosaicY++;
+}
